---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import { WHATSAPP_NUMBER, INSTAGRAM_URL } from '../lib/contact.js';
import { speciesLinks } from '../data/vet-species.js';

export interface Section { h2: string; paragraphs?: string[]; list?: string[]; note?: string }
export interface Faq { q: string; a: string }
export interface Props {
  path: string;              // e.g. '/exotic-vet'
  pageTitle: string;         // <title> target phrase
  metaDescription: string;
  h1: string;
  lead: string;
  eyebrow: string;
  image: string;
  imageAlt: string;
  sections: Section[];
  articleSlugs: string[];    // related articles (must exist)
  articlesHeading: string;
  faq: Faq[];
  waText: string;
}

const p = Astro.props as Props;
const site = Astro.site!;
const url = new URL(p.path, site).href;

const all = await getCollection('articles', ({ data }) => !data.draft);
const related = p.articleSlugs
  .map((slug) => all.find((a) => a.id === slug))
  .filter((a): a is NonNullable<typeof a> => Boolean(a));

const siblings = [
  { href: '/exotic-vet', label: 'دامپزشک اگزوتیک' },
  { href: '/reptile-vet', label: 'دامپزشک خزندگان' },
  { href: '/bird-vet', label: 'دامپزشک پرندگان' },
].filter((s) => s.href !== p.path);

const speciesNav = speciesLinks.filter((s) => s.href !== p.path);

const wa = `https://wa.me/${WHATSAPP_NUMBER}?text=${encodeURIComponent(p.waText)}`;

const providerSchema = {
  '@context': 'https://schema.org',
  '@type': 'VeterinaryCare',
  name: `${p.h1} — دکتر مهدیار رمزگویان`,
  url,
  description: p.metaDescription,
  image: new URL(p.image, site).href,
  telephone: `+${WHATSAPP_NUMBER}`,
  areaServed: [
    { '@type': 'Country', name: 'ایران' },
    { '@type': 'City', name: 'تهران' },
  ],
  availableLanguage: ['fa', 'en'],
  sameAs: [INSTAGRAM_URL],
  employee: {
    '@type': 'Person',
    name: 'دکتر مهدیار رمزگویان',
    jobTitle: 'دامپزشک حیوانات اگزوتیک',
    url: new URL('/about', site).href,
  },
};
const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: p.faq.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'خانه', item: site.href },
    { '@type': 'ListItem', position: 2, name: p.h1, item: url },
  ],
};
---
<Base title={p.pageTitle} description={p.metaDescription} image={p.image}>
  <script type="application/ld+json" set:html={JSON.stringify(providerSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />

  <article class="section container vet-landing">
    <nav class="crumb muted" aria-label="مسیر صفحه"><a href="/">خانه</a> / <span>{p.h1}</span></nav>

    <header class="vl-hero">
      <div class="vl-hero__text">
        <span class="eyebrow">{p.eyebrow}</span>
        <h1>{p.h1}</h1>
        <p class="lead">{p.lead}</p>
        <div class="vl-cta">
          <a class="btn" href="/visit">ویزیت آنلاین رایگان</a>
          <a class="btn btn-ghost" href={wa} target="_blank" rel="noopener">پیام در واتساپ</a>
        </div>
        <p class="vl-warn">ویزیت آنلاین جایگزین معاینهٔ حضوری در موارد اورژانسی نیست.</p>
      </div>
      <img class="vl-hero__img" src={p.image} alt={p.imageAlt} width="720" height="540" fetchpriority="high" />
    </header>

    <div class="prose vl-body">
      {p.sections.map((s) => (
        <section>
          <h2>{s.h2}</h2>
          {s.paragraphs?.map((t) => <p>{t}</p>)}
          {s.list && <ul>{s.list.map((li) => <li>{li}</li>)}</ul>}
          {s.note && <blockquote>{s.note}</blockquote>}
        </section>
      ))}
    </div>

    {related.length > 0 && (
      <section class="vl-related">
        <h2>{p.articlesHeading}</h2>
        <ul class="vl-related__list">
          {related.map((a) => (
            <li><a href={`/articles/${a.id}`}>{a.data.title}</a></li>
          ))}
        </ul>
      </section>
    )}

    <section class="vl-faq">
      <h2>پرسش‌های متداول</h2>
      {p.faq.map((f) => (
        <details>
          <summary>{f.q}</summary>
          <p>{f.a}</p>
        </details>
      ))}
    </section>

    <section class="vl-final">
      <h2>برای شروع، شرح حال و عکس حیوان‌تان را بفرستید</h2>
      <p class="muted">نوع حیوان، سن، علائم و مدت آن را بنویسید و چند عکس واضح از حیوان و محل نگهداری پیوست کنید؛ برای فیلم از واتساپ یا تلگرام استفاده کنید.</p>
      <div class="vl-cta">
        <a class="btn" href="/visit">ثبت درخواست ویزیت آنلاین</a>
        <a class="btn btn-ghost" href="/about">درباره دکتر مهدیار رمزگویان</a>
      </div>
      <nav class="vl-species" aria-label="دامپزشک بر اساس گونه">
        <h3>دامپزشک بر اساس گونه</h3>
        <ul>
          {speciesNav.map((s) => (<li><a href={s.href}>{s.label}</a></li>))}
        </ul>
      </nav>
      <p class="vl-siblings muted">
        {siblings.map((s, i) => (<>{i > 0 && ' · '}<a href={s.href}>{s.label}</a></>))}
      </p>
    </section>
  </article>
</Base>

<style>
  .crumb { font-size: 14px; margin-bottom: 18px; }
  .crumb a:hover { color: var(--brand); }
  .vl-hero { display: grid; grid-template-columns: 1.15fr 1fr; gap: 34px; align-items: center; margin-bottom: 40px; }
  .vl-hero h1 { margin-bottom: 14px; }
  .lead { font-size: clamp(1.02rem, 2vw, 1.18rem); line-height: 2; color: var(--text-muted); max-width: 60ch; }
  .vl-hero__img { width: 100%; height: auto; aspect-ratio: 4/3; object-fit: cover; border-radius: var(--radius); border: 1px solid var(--border); }
  .vl-cta { display: flex; gap: 12px; flex-wrap: wrap; margin-top: 22px; }
  .vl-warn { margin-top: 14px; font-size: 13px; color: var(--text-muted); }
  .vl-body { max-width: 780px; }
  .vl-body blockquote { margin-block: 1.2em; }
  .vl-related, .vl-faq, .vl-final { max-width: 780px; margin-top: 46px; }
  .vl-related h2, .vl-faq h2, .vl-final h2 { font-size: 1.45rem; margin-bottom: 16px; }
  .vl-related__list { list-style: none; padding: 0; display: grid; gap: 10px; }
  .vl-related__list a {
    display: block; padding: 12px 16px; background: var(--surface); border: 1px solid var(--border);
    border-radius: var(--radius-sm); transition: border-color .2s, transform .2s;
  }
  .vl-related__list a:hover { border-color: var(--brand); transform: translateY(-2px); }
  .vl-faq details { background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius-sm); padding: 14px 18px; margin-bottom: 10px; }
  .vl-faq summary { cursor: pointer; font-weight: 700; }
  .vl-faq details p { margin-top: 10px; line-height: 1.95; color: var(--text-muted); }
  .vl-final { padding: 28px; background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius); }
  .vl-species { margin-top: 24px; }
  .vl-species h3 { font-size: 1rem; margin-bottom: 10px; }
  .vl-species ul { list-style: none; padding: 0; display: flex; flex-wrap: wrap; gap: 8px; }
  .vl-species a { display: inline-block; padding: 6px 13px; border: 1px solid var(--border); border-radius: 999px; font-size: 14px; color: var(--text-muted); transition: border-color .2s, color .2s; }
  .vl-species a:hover { border-color: var(--brand); color: var(--text); }
  .vl-siblings { margin-top: 18px; font-size: 14px; }
  .vl-siblings a { color: var(--brand); }
  @media (max-width: 820px) { .vl-hero { grid-template-columns: 1fr; } .vl-hero__img { order: -1; } }
</style>
