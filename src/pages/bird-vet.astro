---
import VetLanding from '../components/VetLanding.astro';

const sections = [
  {
    h2: 'دامپزشک پرندگان چه کاری انجام می‌دهد؟',
    paragraphs: [
      'پرندگان زینتی طعمهٔ طبیعت‌اند و بیماری را تا وقتی ممکن است پنهان می‌کنند؛ وقتی علامتی دیده می‌شود، اغلب بیماری مدتی پیشرفت کرده است. دامپزشک پرندگان با معاینه، بررسی وزن و مدفوع، پرسش دقیق دربارهٔ تغذیه و محیط، و در صورت نیاز آزمایش و تصویربرداری، کمک می‌کند مشکل زودتر شناسایی شود.',
    ],
  },
  {
    h2: 'مشکلات شایع پرندگان زینتی',
    list: [
      'مشکلات تنفسی: عطسه، ترشح، صدای خس‌خس و دم‌جنبانی هنگام نفس کشیدن',
      'کندن پر و رفتارهای تکراری ناشی از استرس یا بی‌حوصلگی',
      'تخم‌گذاری مزمن و گیر کردن تخم (egg binding) در ماده‌ها',
      'مشکلات چینه‌دان و هضم، استفراغ یا بازگرداندن غذا',
