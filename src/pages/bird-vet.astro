const faq = [
  { q: 'چه زمانی پرنده‌ام را باید نزد دامپزشک ببرم؟', a: 'پف کردن پرها، نشستن روی کف قفس، تنفس با دهان باز، کاهش اشتها، تغییر مدفوع و هر رفتار غیرمعمول نشانه‌هایی‌اند که باید جدی گرفته شوند؛ پرندگان کوچک سریع بدحال می‌شوند.' },
  { q: 'آیا ویزیت آنلاین برای پرندگان کافی است؟', a: 'برای بررسی اولیه، اصلاح تغذیه و محیط، رفتارهایی مثل جیغ زدن یا کندن پر و تصمیم‌گیری برای فوری بودن مفید است؛ اما موارد تنفسی، تخم‌گذاری ناموفق و بدحالی شدید نیاز به معاینهٔ حضوری دارند.' },
  { q: 'چرا پرنده‌ام پرهایش را می‌کند؟', a: 'علل ممکن شامل بیماری‌های پوستی و داخلی، کمبود تغذیه‌ای، خشکی هوا، استرس، بی‌حوصلگی و تنهایی است. ابتدا باید علل پزشکی بررسی شوند و سپس رفتار و محیط اصلاح شود.' },
  { q: 'تغذیهٔ مناسب پرندگان زینتی چیست؟', a: 'رژیم فقط‌دانه معمولاً کامل نیست. پلت مناسب به‌عنوان پایهٔ رژیم، سبزی و میوهٔ تازه و دانه به‌عنوان تنقل توصیه می‌شود؛ تغییر رژیم باید تدریجی باشد.' },
  { q: 'چه چیزهایی در خانه برای پرندگان سمی هستند؟', a: 'بخار ظروف تفلون و پوشش‌های نچسب گرم‌شده، دود سیگار و بخور، اسپری‌ها و خوشبوکننده‌ها، برخی گیاهان خانگی و بعضی غذاها مثل آووکادو و شکلات برای پرندگان خطرناک‌اند.' },
  { q: 'آیا پرندگان به انسان بیماری منتقل می‌کنند؟', a: 'برخی بیماری‌ها مثل پسیتاکوز (کلامیدیوز) می‌توانند منتقل شوند. رعایت بهداشت، شست‌وشوی دست و بررسی پرندهٔ جدید پیش از ورود به خانه اهمیت دارد.' },
];
