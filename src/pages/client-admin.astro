---
import Base from '../layouts/Base.astro';
---
<Base
  title="پنل مدیریت"
  description="افزودن پرونده مشتری جدید"
  noindex={true}
>
  <section class="portal-auth">
    <div class="auth-card admin-card">
      <div id="admin-loading" class="auth-sub">در حال بررسی دسترسی...</div>
      <div id="admin-denied" class="auth-sub" hidden>
        این حساب دسترسی مدیریت ندارد. <a href="/login">بازگشت به ورود</a>
      </div>

      <div id="admin-area" hidden>
        <form id="new-client-form">
          <h1>افزودن پرونده جدید</h1>
          <p class="auth-sub">یک نام کاربری و رمز عبور برای کلاینت ساخته می‌شود که خودتان به او می‌دهید.</p>

          <label>
            نام و نام خانوادگی *
            <input type="text" name="full_name" required />
          </label>
          <label>
            شماره تماس *
            <input type="text" name="phone" required />
          </label>
          <label>
            نام کاربری کلاینت * <span class="hint">(فقط حروف/عدد انگلیسی، مثلاً sara_m)</span>
            <input type="text" name="username" required />
          </label>
          <label>
            ایمیل تماس (اختیاری، اگر متفاوت است)
            <input type="email" name="email" />
          </label>
          <label>
            کد ملی
            <input type="text" name="national_id" />
          </label>
          <label>
            آدرس
            <input type="text" name="address" />
          </label>
          <label>
            گونه/نژاد
            <input type="text" name="subject" placeholder="مثلاً طوطی کاکادو، لاک‌پشت گوش قرمز" />
          </label>

          <button type="submit">ثبت پرونده</button>
          <p id="form-msg" class="auth-error" hidden></p>
        </form>

        <div id="credentials-box" class="credentials-box" hidden>
          <h2>اطلاعات ورود کلاینت</h2>
          <p class="auth-sub">این اطلاعات فقط همین یک‌بار نمایش داده می‌شود — همین الان کپی و برای کلاینت ارسال کنید.</p>
          <div class="cred-row">
            <span>نام کاربری:</span>
            <code id="cred-username"></code>
          </div>
          <div class="cred-row">
            <span>رمز عبور:</span>
            <code id="cred-password"></code>
          </div>
          <button type="button" id="copy-creds-btn">کپی اطلاعات</button>
        </div>
      </div>
    </div>
  </section>

  <section class="clients-section" id="clients-section" hidden>
    <h2>مشتریان</h2>
    <div id="clients-list" class="clients-list">
      <p class="auth-sub">در حال بارگذاری...</p>
    </div>
  </section>
</Base>

<style>
  .portal-auth {
    min-height: 70vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 48px 20px;
  }
  .auth-card {
    width: 100%;
    max-width: 460px;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    box-shadow: var(--shadow);
    padding: 32px 28px;
  }
  .auth-card h1 {
    font-size: 20px;
    margin-bottom: 4px;
  }
  .auth-sub {
    color: var(--text-muted);
    font-size: 14px;
    margin-bottom: 20px;
  }
  .hint {
    font-weight: 400;
    font-size: 12px;
  }
  form {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  label {
    display: flex;
    flex-direction: column;
    gap: 6px;
    font-size: 14px;
    color: var(--text-muted);
  }
  input {
    background: var(--bg-soft);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    padding: 10px 12px;
    color: var(--text);
    font-family: var(--font);
    font-size: 15px;
  }
  input:focus {
    outline: 2px solid var(--brand);
    outline-offset: 1px;
  }
  button {
    margin-top: 8px;
    background: var(--brand);
    color: #06110b;
    border: none;
    border-radius: var(--radius-sm);
    padding: 12px;
    font-family: var(--font);
    font-weight: 700;
    font-size: 15px;
    cursor: pointer;
  }
  button:hover { background: var(--brand-strong); }
  button:disabled { opacity: 0.6; cursor: default; }
  .auth-error {
    font-size: 14px;
    text-align: center;
  }
  .auth-error.ok { color: #8fd6a8; }
  .auth-error.err { color: #e88a6a; }
  .credentials-box {
    margin-top: 24px;
    padding-top: 24px;
    border-top: 1px solid var(--border);
  }
  .credentials-box h2 {
    font-size: 16px;
    margin-bottom: 6px;
  }
  .cred-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    background: var(--bg-soft);
    border-radius: var(--radius-sm);
    padding: 10px 14px;
    margin-bottom: 8px;
  }
  .cred-row code {
    color: var(--brand-strong);
    font-weight: 700;
    direction: ltr;
  }
  .clients-section {
    max-width: 640px;
    margin: 0 auto;
    padding: 0 20px 60px;
  }
  .clients-section h2 {
    font-size: 18px;
    margin-bottom: 16px;
  }
  .clients-list {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .client-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 10px;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    padding: 14px 16px;
  }
  .client-row-info { font-size: 14px; }
  .client-row-info .client-meta {
    color: var(--text-muted);
    font-size: 12px;
    margin-top: 2px;
  }
  .client-row a.manage-link {
    background: transparent;
    border: 1px solid var(--border);
    color: var(--text);
    border-radius: var(--radius-sm);
    padding: 6px 14px;
    font-size: 13px;
    white-space: nowrap;
  }
  .client-row a.manage-link:hover {
    border-color: var(--brand);
    color: var(--brand);
  }
</style>

<script>
  import { supabase, usernameToEmail } from '../lib/supabase.js';

  const FUNCTION_URL = 'https://vyqubahucjzinpwgptxi.supabase.co/functions/v1/create-client';

  const loadingBox = document.getElementById('admin-loading') as HTMLElement;
  const deniedBox = document.getElementById('admin-denied') as HTMLElement;
  const adminArea = document.getElementById('admin-area') as HTMLElement;
  const form = document.getElementById('new-client-form') as HTMLFormElement;
  const msgBox = document.getElementById('form-msg') as HTMLParagraphElement;
  const credBox = document.getElementById('credentials-box') as HTMLElement;
  const credUsername = document.getElementById('cred-username') as HTMLElement;
  const credPassword = document.getElementById('cred-password') as HTMLElement;

  function esc(value: unknown): string {
    return String(value ?? '').replace(/[&<>"']/g, (c) => ({
      '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;',
    }[c] as string));
  }

  async function loadClients() {
    const listEl = document.getElementById('clients-list') as HTMLElement;
    const [{ data: clients }, { data: allPets }] = await Promise.all([
      supabase.from('clients').select('id, full_name, phone').order('created_at', { ascending: false }),
      supabase.from('pets').select('client_id, name, species_breed, next_visit_date'),
    ]);

    if (!clients || !clients.length) {
      listEl.innerHTML = '<p class="auth-sub">هنوز مشتری‌ای ثبت نشده است.</p>';
      return;
    }

    const petsByClient = new Map<number, any[]>();
    for (const p of allPets ?? []) {
      const list = petsByClient.get(p.client_id) ?? [];
      list.push(p);
      petsByClient.set(p.client_id, list);
    }

    listEl.innerHTML = clients.map((c) => {
      const clientPets = petsByClient.get(c.id) ?? [];
      let petMeta = '';
      if (clientPets.length === 1) {
        const p = clientPets[0];
        petMeta = [p.name ? 'پت: ' + p.name : '', p.species_breed ?? '', p.next_visit_date ? 'مراجعه: ' + new Date(p.next_visit_date).toLocaleDateString('fa-IR') : ''].filter(Boolean).join(' - ');
      } else if (clientPets.length > 1) {
        petMeta = `${clientPets.length} پت`;
      }
      return `
      <div class="client-row">
        <div class="client-row-info">
          <div>${esc(c.full_name)}</div>
          <div class="client-meta">${[c.phone, petMeta].filter(Boolean).map(esc).join(' - ')}</div>
        </div>
        <a class="manage-link" href="/client-manage?id=${c.id}">مدیریت پرونده</a>
      </div>
    `;
    }).join('');
  }

  async function init() {
    const { data: sessionData } = await supabase.auth.getSession();
    if (!sessionData.session) {
      window.location.href = '/login';
      return;
    }

    const { data: isAdmin } = await supabase.rpc('is_admin');
    loadingBox.hidden = true;

    if (!isAdmin) {
      deniedBox.hidden = false;
      return;
    }

    adminArea.hidden = false;
    (document.getElementById('clients-section') as HTMLElement).hidden = false;
    await loadClients();
  }

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    msgBox.hidden = true;
    credBox.hidden = true;
    const submitBtn = form.querySelector('button') as HTMLButtonElement;
    submitBtn.disabled = true;

    const { data: sessionData } = await supabase.auth.getSession();
    const token = sessionData.session?.access_token;

    const formData = new FormData(form);
    const rawUsername = String(formData.get('username') || '').trim();
    const payload = Object.fromEntries(formData.entries());
    payload.login_email = usernameToEmail(rawUsername);
    delete payload.username;

    try {
      const res = await fetch(FUNCTION_URL, {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          Authorization: `Bearer ${token}`,
        },
        body: JSON.stringify(payload),
      });
      const result = await res.json();

      if (!res.ok) {
        msgBox.textContent = result.error || 'خطایی رخ داد.';
        msgBox.className = 'auth-error err';
        msgBox.hidden = false;
      } else {
        msgBox.textContent = 'پرونده با موفقیت ثبت شد.';
        msgBox.className = 'auth-error ok';
        msgBox.hidden = false;
        credUsername.textContent = rawUsername;
        credPassword.textContent = result.password;
        credBox.hidden = false;
        form.reset();
        await loadClients();
      }
    } catch (err) {
      msgBox.textContent = 'ارتباط با سرور برقرار نشد.';
      msgBox.className = 'auth-error err';
      msgBox.hidden = false;
    } finally {
      submitBtn.disabled = false;
    }
  });

  document.getElementById('copy-creds-btn')?.addEventListener('click', async () => {
    const text = `نام کاربری: ${credUsername.textContent}\nرمز عبور: ${credPassword.textContent}\nورود از: ${location.origin}/login`;
    try {
      await navigator.clipboard.writeText(text);
    } catch {
      // clipboard API may be unavailable; the text is already visible to copy manually
    }
  });

  init();
</script>
