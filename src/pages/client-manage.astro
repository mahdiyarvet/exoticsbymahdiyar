---
import Base from '../layouts/Base.astro';
---
<Base
  title="مدیریت پرونده مشتری"
  description="مدیریت پرونده دامپزشکی مشتری و پت‌های او"
  noindex={true}
>
  <section class="manage">
    <div id="manage-loading" class="manage-status">در حال بررسی دسترسی...</div>
    <div id="manage-denied" class="manage-status" hidden>
      این حساب دسترسی مدیریت ندارد. <a href="/login">بازگشت به ورود</a>
    </div>
    <div id="manage-notfound" class="manage-status" hidden>
      پرونده‌ای پیدا نشد. <a href="/client-admin">بازگشت</a>
    </div>

    <div id="manage-area" hidden>
      <a href="/client-admin" class="back-link">&rarr; بازگشت به لیست مشتریان</a>

      <div class="client-bar">
        <div>
          <span class="record-kicker">مشتری</span>
          <h1 id="client-name"></h1>
          <p id="client-meta" class="manage-sub"></p>
        </div>
      </div>

      <div class="pets-bar" id="pets-bar"></div>
      <div id="add-pet-wrap" class="add-pet-wrap" hidden>
        <form id="add-pet-form" class="stack-form-row">
          <input type="text" name="name" placeholder="نام پت (اختیاری)" />
          <input type="text" name="species_breed" placeholder="گونه/نژاد" />
          <button type="submit">افزودن پت</button>
        </form>
        <p id="add-pet-msg" class="form-msg" hidden></p>
      </div>

      <div id="pet-record" class="record" hidden>
        <div class="record-header">
          <div class="pet-photo-wrap">
            <img id="pet-photo" class="pet-photo" alt="عکس پت" hidden />
            <div id="pet-photo-placeholder" class="pet-photo-placeholder">بدون عکس</div>
          </div>
          <div class="record-header-info">
            <span class="record-kicker">پرونده دامپزشکی</span>
            <h2 id="pet-title">—</h2>
            <dl class="fact-list" id="pet-fact-list"></dl>
          </div>
          <button type="button" id="delete-pet-btn" class="danger-link">حذف این پت</button>
        </div>

        <div id="allergy-banner" class="allergy-banner" hidden>
          ⚠️ هشدار آلرژی/حساسیت دارویی: <strong id="allergy-text"></strong>
        </div>

        <section class="record-section">
          <h2>مشخصات پت</h2>
          <form id="pet-details-form" class="inline-form">
            <label>نام پت
              <input type="text" name="name" />
            </label>
            <label>گونه/نژاد
              <input type="text" name="species_breed" />
            </label>
            <label>جنسیت
              <select name="sex">
                <option value="">نامشخص</option>
                <option value="male">نر</option>
                <option value="female">ماده</option>
              </select>
            </label>
            <label>تاریخ تولد (تقریبی)
              <input type="date" name="birth_date" />
            </label>
            <label>رنگ‌بندی / نشانه‌ها
              <input type="text" name="color_markings" />
            </label>
            <label>شماره میکروچیپ / بند پا
              <input type="text" name="microchip_band" />
            </label>
            <label class="span-2">آلرژی / حساسیت دارویی
              <input type="text" name="allergies" placeholder="در صورت وجود بنویسید — در بالای پرونده به‌صورت هشدار نمایش داده می‌شود" />
            </label>
            <button type="submit" class="span-2">ذخیره مشخصات</button>
          </form>
          <p id="pet-details-msg" class="form-msg" hidden></p>
        </section>

        <section class="record-section">
          <h2>عکس پت</h2>
          <form id="photo-form" class="stack-form-row">
            <input type="file" name="photo" accept="image/*" required />
            <button type="submit">آپلود / جایگزینی عکس</button>
          </form>
          <p id="photo-msg" class="form-msg" hidden></p>
        </section>

        <section class="record-section">
          <h2>تاریخ مراجعه بعدی</h2>
          <form id="visit-date-form" class="stack-form-row">
            <input type="date" name="next_visit_date" />
            <button type="submit">ذخیره تاریخ</button>
          </form>
          <p id="visit-date-msg" class="form-msg" hidden></p>
        </section>

        <section class="record-section">
          <h2>جدول زمانی پرونده</h2>
          <p class="manage-hint">همه‌ی ویزیت‌ها، یادداشت‌ها، سوابق پزشکی و فایل‌ها به ترتیب تاریخ.</p>
          <div id="timeline-list" class="manage-list"></div>
        </section>

        <section class="record-section">
          <h2>ثبت ویزیت جدید (SOAP)</h2>
          <form id="visit-form" class="stack-form">
            <input type="date" name="visit_date" required />
            <textarea name="subjective" rows="2" placeholder="S — شرح صاحب حیوان از وضعیت"></textarea>
            <textarea name="objective" rows="2" placeholder="O — یافته‌های معاینه"></textarea>
            <textarea name="assessment" rows="2" placeholder="A — تشخیص"></textarea>
            <textarea name="plan" rows="2" placeholder="P — برنامه درمان"></textarea>
            <label class="checkbox-row">
              <input type="checkbox" name="visible" checked />
              قابل مشاهده برای مشتری
            </label>
            <button type="submit">ثبت ویزیت</button>
          </form>
          <p id="visit-msg" class="form-msg" hidden></p>
        </section>

        <section class="record-section">
          <h2>افزودن یادداشت پیگیری</h2>
          <form id="note-form" class="stack-form">
            <textarea name="note" rows="3" placeholder="متن یادداشت" required></textarea>
            <label class="checkbox-row">
              <input type="checkbox" name="visible" checked />
              قابل مشاهده برای مشتری
            </label>
            <button type="submit">افزودن یادداشت</button>
          </form>
        </section>

        <section class="record-section">
          <h2>آپلود مدرک/فایل</h2>
          <form id="file-form" class="stack-form">
            <input type="file" name="file" required />
            <input type="text" name="description" placeholder="توضیح فایل (اختیاری)" />
            <button type="submit">آپلود فایل</button>
          </form>
          <p id="file-msg" class="form-msg" hidden></p>
        </section>

        <section class="record-section">
          <h2>ثبت سوابق پزشکی و علمی</h2>
          <p id="medical-msg" class="form-msg" hidden></p>
          <div class="medical-grid">
            <div class="medical-box">
              <h3>وزن</h3>
              <form class="stack-form medical-subform" data-record-type="weight">
                <input type="date" name="record_date" required />
                <input type="text" name="value" placeholder="وزن (گرم)" required />
                <input type="text" name="note" placeholder="یادداشت (اختیاری)" />
                <label class="checkbox-row">
                  <input type="checkbox" name="visible" checked />
                  قابل مشاهده برای مشتری
                </label>
                <button type="submit">ثبت وزن</button>
              </form>
            </div>

            <div class="medical-box">
              <h3>تزریق / واکسن</h3>
              <form class="stack-form medical-subform" data-record-type="injection">
                <input type="date" name="record_date" required />
                <input type="text" name="title" placeholder="نام واکسن یا دارو" required />
                <input type="text" name="value" placeholder="دوز و روش تزریق" />
                <input type="text" name="note" placeholder="یادداشت (اختیاری)" />
                <label class="checkbox-row">
                  <input type="checkbox" name="visible" checked />
                  قابل مشاهده برای مشتری
                </label>
                <button type="submit">ثبت تزریق</button>
              </form>
            </div>

            <div class="medical-box">
              <h3>نسخه</h3>
              <form class="stack-form medical-subform" data-record-type="prescription">
                <input type="date" name="record_date" required />
                <input type="text" name="title" placeholder="نام دارو" required />
                <input type="text" name="value" placeholder="دوز و دستور مصرف" />
                <input type="text" name="note" placeholder="یادداشت (اختیاری)" />
                <label class="checkbox-row">
                  <input type="checkbox" name="visible" checked />
                  قابل مشاهده برای مشتری
                </label>
                <button type="submit">ثبت نسخه</button>
              </form>
            </div>

            <div class="medical-box">
              <h3>سایر موارد علمی</h3>
              <form class="stack-form medical-subform" data-record-type="other">
                <input type="date" name="record_date" required />
                <input type="text" name="title" placeholder="عنوان" required />
                <input type="text" name="value" placeholder="توضیح" />
                <input type="text" name="note" placeholder="یادداشت (اختیاری)" />
                <label class="checkbox-row">
                  <input type="checkbox" name="visible" checked />
                  قابل مشاهده برای مشتری
                </label>
                <button type="submit">ثبت</button>
              </form>
            </div>
          </div>
        </section>
      </div>
    </div>
  </section>
</Base>

<style>
  .manage {
    max-width: 780px;
    margin: 0 auto;
    padding: 32px 20px 80px;
    min-height: 60vh;
  }
  .manage-status {
    text-align: center;
    color: var(--text-muted);
    padding: 60px 0;
  }
  .back-link {
    display: inline-block;
    color: var(--text-muted);
    font-size: 13px;
    margin-bottom: 16px;
  }
  .back-link:hover { color: var(--brand); }

  .client-bar {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 16px 20px;
    margin-bottom: 14px;
  }
  .client-bar h1 { font-size: 19px; }
  .manage-sub { color: var(--text-muted); margin-top: 4px; font-size: 13px; }

  .pets-bar {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 10px;
  }
  .pet-chip {
    background: var(--surface);
    border: 1px solid var(--border);
    color: var(--text);
    border-radius: 999px;
    padding: 7px 16px;
    font-size: 13px;
    font-family: var(--font);
    cursor: pointer;
  }
  .pet-chip:hover { border-color: var(--brand); }
  .pet-chip.active { background: var(--brand); border-color: var(--brand); color: #06110b; font-weight: 700; }
  .pet-chip.add-chip { border-style: dashed; color: var(--text-muted); }
  .add-pet-wrap {
    background: var(--bg-soft);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    padding: 14px;
    margin-bottom: 16px;
  }

  .record {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    overflow: hidden;
  }
  .record-header {
    display: flex;
    align-items: center;
    gap: 20px;
    padding: 22px;
    border-bottom: 1px solid var(--border);
    position: relative;
  }
  .record-header-info { flex: 1; min-width: 0; }
  .record-kicker {
    display: block;
    color: var(--brand);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.04em;
    margin-bottom: 4px;
  }
  .pet-photo-wrap {
    width: 132px;
    height: 132px;
    border-radius: 14px;
    overflow: hidden;
    background: var(--bg-soft);
    border: 1px solid var(--border);
    flex: none;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .pet-photo { width: 100%; height: 100%; object-fit: cover; }
  .pet-photo-placeholder { font-size: 12px; color: var(--text-muted); text-align: center; padding: 4px; }
  .record-header h2 { font-size: 21px; line-height: 1.3; margin-bottom: 8px; }
  .fact-list { display: flex; flex-direction: column; gap: 3px; }
  .fact-row { display: flex; gap: 8px; font-size: 12.5px; }
  .fact-row dt { color: var(--text-muted); flex: none; width: 130px; }
  .fact-row dd { color: var(--text); }
  .danger-link {
    position: absolute;
    top: 18px;
    left: 18px;
    background: transparent;
    border: 1px solid var(--border);
    color: var(--text-muted);
    border-radius: var(--radius-sm);
    padding: 5px 12px;
    font-size: 12px;
    font-family: var(--font);
    cursor: pointer;
  }
  .danger-link:hover { border-color: #e88a6a; color: #e88a6a; }

  @media (max-width: 560px) {
    .record-header { flex-direction: column; align-items: flex-start; padding-top: 50px; }
    .pet-photo-wrap { width: 100%; height: 180px; border-radius: var(--radius-sm); }
  }

  .allergy-banner {
    margin: 0 22px;
    margin-top: 16px;
    background: #4a1f1f;
    border: 1px solid #7a3030;
    color: #f3d3d3;
    border-radius: var(--radius-sm);
    padding: 10px 14px;
    font-size: 13px;
  }

  .record-section {
    padding: 18px 22px;
    border-bottom: 1px solid var(--border);
  }
  .record-section:last-child { border-bottom: none; }
  .record-section h2 {
    font-size: 14px;
    font-weight: 700;
    color: var(--text-muted);
    letter-spacing: 0.02em;
    margin-bottom: 10px;
  }
  .manage-hint { color: var(--text-muted); font-size: 12.5px; margin-top: -4px; margin-bottom: 12px; }

  .inline-form {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 10px;
  }
  .inline-form label {
    display: flex;
    flex-direction: column;
    gap: 5px;
    font-size: 13px;
    color: var(--text-muted);
  }
  .inline-form .span-2 { grid-column: 1 / -1; }
  .inline-form input, .inline-form select {
    background: var(--bg-soft);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    padding: 8px 11px;
    color: var(--text);
    font-family: var(--font);
    font-size: 14px;
  }
  .inline-form button {
    background: var(--brand);
    color: #06110b;
    border: none;
    border-radius: var(--radius-sm);
    padding: 9px;
    font-family: var(--font);
    font-weight: 700;
    font-size: 14px;
    cursor: pointer;
  }
  .inline-form button:hover { background: var(--brand-strong); }

  .medical-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 14px;
  }
  @media (max-width: 560px) {
    .medical-grid { grid-template-columns: 1fr; }
  }
  .medical-box {
    background: var(--bg-soft);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    padding: 14px;
  }
  .medical-box h3 {
    font-size: 13px;
    font-weight: 700;
    color: var(--brand);
    margin-bottom: 10px;
  }
  .manage-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .manage-list li, .manage-list > div {
    background: var(--bg-soft);
    border-radius: var(--radius-sm);
    padding: 10px 14px;
  }
  .manage-empty-item {
    color: var(--text-muted);
    font-size: 14px;
    background: transparent !important;
    padding: 0 !important;
  }
  .file-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 10px;
  }
  .file-row a { color: var(--brand-strong); font-weight: 600; }
  .file-meta, .item-meta { font-size: 12px; color: var(--text-muted); margin-top: 4px; }
  .note-item {
    background: var(--bg-soft);
    border-radius: var(--radius-sm);
    border-right: 3px solid var(--brand);
    padding: 12px 14px;
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 10px;
  }
  .badge {
    display: inline-block;
    border-radius: 999px;
    padding: 2px 10px;
    font-size: 11px;
    font-weight: 700;
  }
  .badge-visible { background: #2f5d3a; color: #cdeed8; }
  .badge-hidden { background: #444; color: #ccc; }
  .badge-type { background: var(--surface); border: 1px solid var(--border); color: var(--brand); margin-inline-end: 6px; }
  .row-actions { display: flex; gap: 6px; flex: none; }
  .icon-btn {
    background: transparent;
    border: 1px solid var(--border);
    color: var(--text-muted);
    border-radius: var(--radius-sm);
    padding: 4px 10px;
    font-size: 12px;
    font-family: var(--font);
    cursor: pointer;
    white-space: nowrap;
  }
  .icon-btn:hover { border-color: var(--brand); color: var(--brand); }
  .icon-btn.danger:hover { border-color: #e88a6a; color: #e88a6a; }
  .stack-form, .stack-form-row {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .stack-form-row { flex-direction: row; flex-wrap: wrap; align-items: center; }
  .stack-form-row input { flex: 1; min-width: 140px; }
  .stack-form input[type="text"],
  .stack-form input[type="date"],
  .stack-form input[type="file"],
  .stack-form select,
  .stack-form textarea,
  .stack-form-row input[type="text"],
  .stack-form-row input[type="date"],
  .stack-form-row input[type="file"] {
    background: var(--bg-soft);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    padding: 9px 12px;
    color: var(--text);
    font-family: var(--font);
    font-size: 14px;
  }
  .stack-form textarea { resize: vertical; }
  .checkbox-row {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 13px;
    color: var(--text-muted);
  }
  .stack-form button, .stack-form-row button {
    background: var(--brand);
    color: #06110b;
    border: none;
    border-radius: var(--radius-sm);
    padding: 10px;
    font-family: var(--font);
    font-weight: 700;
    font-size: 14px;
    cursor: pointer;
    white-space: nowrap;
  }
  .stack-form button:hover, .stack-form-row button:hover { background: var(--brand-strong); }
  .stack-form button:disabled, .stack-form-row button:disabled { opacity: 0.6; cursor: default; }
  .form-msg { font-size: 13px; }
  .form-msg.ok { color: #8fd6a8; }
  .form-msg.err { color: #e88a6a; }
</style>

<script>
  import { supabase } from '../lib/supabase.js';

  const el = (id: string) => document.getElementById(id) as HTMLElement;
  const clientId = new URLSearchParams(window.location.search).get('id');
  const PET_FUNCTION_URL = 'https://vyqubahucjzinpwgptxi.supabase.co/functions/v1/admin-manage-pet';

  function safeStoragePath(clientId: number, filename: string): string {
    const match = filename.match(/\.[a-zA-Z0-9]{1,10}$/);
    const ext = match ? match[0] : '';
    const id = (crypto as any).randomUUID ? crypto.randomUUID() : String(Date.now());
    return `${clientId}/${id}${ext}`;
  }

  function esc(value: unknown): string {
    return String(value ?? '').replace(/[&<>"']/g, (c) => ({
      '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;',
    }[c] as string));
  }
  function formatDate(iso: string) {
    return new Date(iso).toLocaleDateString('fa-IR');
  }

  const MEDICAL_TYPE_LABELS: Record<string, string> = {
    weight: 'وزن',
    injection: 'تزریق / واکسن',
    prescription: 'نسخه',
    other: 'سایر',
  };
  const SEX_LABELS: Record<string, string> = { male: 'نر', female: 'ماده' };

  let client: any = null;
  let pets: any[] = [];
  let activePetId: number | null = null;

  async function callPetFunction(payload: Record<string, unknown>) {
    const { data: sessionData } = await supabase.auth.getSession();
    const token = sessionData.session?.access_token;
    const res = await fetch(PET_FUNCTION_URL, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', Authorization: `Bearer ${token}` },
      body: JSON.stringify(payload),
    });
    return res.json();
  }

  function renderPetsBar() {
    const bar = el('pets-bar');
    bar.innerHTML = pets.map((p) => `
      <button class="pet-chip ${p.id === activePetId ? 'active' : ''}" data-pet-id="${p.id}">
        ${esc(p.name || p.species_breed || 'پت بدون نام')}
      </button>
    `).join('') + `<button class="pet-chip add-chip" id="add-pet-chip" type="button">+ افزودن پت</button>`;

    bar.querySelectorAll<HTMLButtonElement>('[data-pet-id]').forEach((btn) => {
      btn.addEventListener('click', () => selectPet(Number(btn.dataset.petId)));
    });
    el('add-pet-chip')?.addEventListener('click', () => {
      const wrap = el('add-pet-wrap');
      wrap.hidden = !wrap.hidden;
    });
  }

  function renderPetHeader(pet: any) {
    el('pet-title').textContent = pet.name || pet.species_breed || 'پت بدون نام';

    const facts: Array<[string, string]> = [];
    if (pet.species_breed) facts.push(['گونه/نژاد', pet.species_breed]);
    if (pet.sex) facts.push(['جنسیت', SEX_LABELS[pet.sex] ?? pet.sex]);
    if (pet.birth_date) facts.push(['تاریخ تولد', formatDate(pet.birth_date)]);
    if (pet.color_markings) facts.push(['رنگ‌بندی/نشانه‌ها', pet.color_markings]);
    if (pet.microchip_band) facts.push(['میکروچیپ/بند پا', pet.microchip_band]);
    if (pet.next_visit_date) facts.push(['مراجعه بعدی', formatDate(pet.next_visit_date)]);
    el('pet-fact-list').innerHTML = facts.map(([k, v]) => `
      <div class="fact-row"><dt>${esc(k)}</dt><dd>${esc(v)}</dd></div>
    `).join('') || '<p class="manage-empty-item">مشخصاتی ثبت نشده است.</p>';

    if (pet.allergies) {
      el('allergy-text').textContent = pet.allergies;
      el('allergy-banner').hidden = false;
    } else {
      el('allergy-banner').hidden = true;
    }

    const form = el('pet-details-form') as HTMLFormElement;
    (form.elements.namedItem('name') as HTMLInputElement).value = pet.name ?? '';
    (form.elements.namedItem('species_breed') as HTMLInputElement).value = pet.species_breed ?? '';
    (form.elements.namedItem('sex') as HTMLSelectElement).value = pet.sex ?? '';
    (form.elements.namedItem('birth_date') as HTMLInputElement).value = pet.birth_date ?? '';
    (form.elements.namedItem('color_markings') as HTMLInputElement).value = pet.color_markings ?? '';
    (form.elements.namedItem('microchip_band') as HTMLInputElement).value = pet.microchip_band ?? '';
    (form.elements.namedItem('allergies') as HTMLInputElement).value = pet.allergies ?? '';

    const visitDateForm = el('visit-date-form') as HTMLFormElement;
    (visitDateForm.elements.namedItem('next_visit_date') as HTMLInputElement).value = pet.next_visit_date ?? '';
  }

  async function loadPhoto(petId: number) {
    const { data: files } = await supabase
      .from('client_files')
      .select('*')
      .eq('pet_id', petId)
      .eq('is_pet_photo', true)
      .order('uploaded_at', { ascending: false })
      .limit(1);

    const photo = files?.[0];
    const img = el('pet-photo') as HTMLImageElement;
    const placeholder = el('pet-photo-placeholder');
    if (!photo) {
      img.hidden = true;
      placeholder.hidden = false;
      return;
    }
    const { data: signed } = await supabase.storage
      .from('client-files')
      .createSignedUrl(photo.storage_path, 60 * 30);
    if (signed?.signedUrl) {
      img.src = signed.signedUrl;
      img.hidden = false;
      placeholder.hidden = true;
    }
  }

  function timelineRow(opts: {
    badge: string; date: string; detailHtml: string;
    visible?: boolean; kind: string; id: number; path?: string;
  }) {
    const hasVisibility = opts.kind !== 'file';
    const toggleBtn = hasVisibility
      ? `<button class="icon-btn" data-toggle data-kind="${opts.kind}" data-id="${opts.id}" data-visible="${opts.visible}">${opts.visible ? 'مخفی کن' : 'نمایش بده'}</button>`
      : '';
    const visBadge = hasVisibility
      ? `<div class="item-meta"><span class="badge ${opts.visible ? 'badge-visible' : 'badge-hidden'}">${opts.visible ? 'قابل مشاهده برای مشتری' : 'مخفی از مشتری'}</span></div>`
      : '';
    return `
      <div class="note-item">
        <div>
          <div><span class="badge badge-type">${esc(opts.badge)}</span> ${opts.date}</div>
          <div class="item-meta">${opts.detailHtml}</div>
          ${visBadge}
        </div>
        <div class="row-actions">
          ${toggleBtn}
          <button class="icon-btn danger" data-delete data-kind="${opts.kind}" data-id="${opts.id}"${opts.path ? ` data-path="${esc(opts.path)}"` : ''}>حذف</button>
        </div>
      </div>
    `;
  }

  async function loadTimeline(petId: number) {
    const [{ data: visits }, { data: notes }, { data: medical }, { data: files }] = await Promise.all([
      supabase.from('visits').select('*').eq('pet_id', petId),
      supabase.from('client_notes').select('*').eq('pet_id', petId),
      supabase.from('client_medical_records').select('*').eq('pet_id', petId),
      supabase.from('client_files').select('*').eq('pet_id', petId).eq('is_pet_photo', false),
    ]);

    type Entry = { sortKey: string; html: string };
    const entries: Entry[] = [];

    for (const v of visits ?? []) {
      const parts = [
        v.subjective && `<b>S:</b> ${esc(v.subjective)}`,
        v.objective && `<b>O:</b> ${esc(v.objective)}`,
        v.assessment && `<b>A:</b> ${esc(v.assessment)}`,
        v.plan && `<b>P:</b> ${esc(v.plan)}`,
      ].filter(Boolean).join('<br/>');
      entries.push({
        sortKey: `${v.visit_date}T00:00:00_v${v.id}`,
        html: timelineRow({
          badge: 'ویزیت', date: formatDate(v.visit_date), detailHtml: parts || '—',
          visible: v.is_visible_to_client, kind: 'visit', id: v.id,
        }),
      });
    }
    for (const n of notes ?? []) {
      entries.push({
        sortKey: `${n.created_at}_n${n.id}`,
        html: timelineRow({
          badge: 'یادداشت', date: formatDate(n.created_at), detailHtml: esc(n.note),
          visible: n.is_visible_to_client, kind: 'note', id: n.id,
        }),
      });
    }
    for (const m of medical ?? []) {
      const valParts = [m.title, m.value].filter(Boolean).map(esc).join(' — ');
      const detail = [valParts, m.note ? esc(m.note) : ''].filter(Boolean).join('<br/>');
      entries.push({
        sortKey: `${m.record_date}T00:00:00_m${m.id}`,
        html: timelineRow({
          badge: MEDICAL_TYPE_LABELS[m.record_type] ?? m.record_type, date: formatDate(m.record_date),
          detailHtml: detail || '—', visible: m.is_visible_to_client, kind: 'medical', id: m.id,
        }),
      });
    }
    for (const f of files ?? []) {
      const { data: signed } = await supabase.storage.from('client-files').createSignedUrl(f.storage_path, 60 * 5);
      const link = `<a href="${signed?.signedUrl ?? '#'}" target="_blank" rel="noopener">${esc(f.original_filename)}</a>`;
      const detail = [link, f.description ? esc(f.description) : ''].filter(Boolean).join('<br/>');
      entries.push({
        sortKey: `${f.uploaded_at}_f${f.id}`,
        html: timelineRow({
          badge: 'فایل', date: formatDate(f.uploaded_at), detailHtml: detail,
          kind: 'file', id: f.id, path: f.storage_path,
        }),
      });
    }

    entries.sort((a, b) => (a.sortKey < b.sortKey ? 1 : -1));

    const wrap = el('timeline-list');
    if (!entries.length) {
      wrap.innerHTML = '<p class="manage-empty-item">هنوز چیزی ثبت نشده است.</p>';
      return;
    }
    wrap.innerHTML = entries.map((e) => e.html).join('');

    wrap.querySelectorAll<HTMLButtonElement>('[data-toggle]').forEach((btn) => {
      btn.addEventListener('click', async () => {
        const kind = btn.dataset.kind;
        const id = btn.dataset.id;
        const current = btn.dataset.visible === 'true';
        const table = kind === 'visit' ? 'visits' : kind === 'note' ? 'client_notes' : 'client_medical_records';
        await supabase.from(table).update({ is_visible_to_client: !current }).eq('id', id);
        await loadTimeline(petId);
      });
    });
    wrap.querySelectorAll<HTMLButtonElement>('[data-delete]').forEach((btn) => {
      btn.addEventListener('click', async () => {
        const kind = btn.dataset.kind;
        const id = btn.dataset.id;
        if (kind === 'file') {
          const path = btn.dataset.path;
          if (path) await supabase.storage.from('client-files').remove([path]);
          await supabase.from('client_files').delete().eq('id', id);
        } else {
          const table = kind === 'visit' ? 'visits' : kind === 'note' ? 'client_notes' : 'client_medical_records';
          await supabase.from(table).delete().eq('id', id);
        }
        await loadTimeline(petId);
      });
    });
  }

  async function selectPet(petId: number) {
    const pet = pets.find((p) => p.id === petId);
    if (!pet) return;
    activePetId = petId;
    renderPetsBar();
    el('pet-record').hidden = false;
    renderPetHeader(pet);

    const today = new Date().toISOString().slice(0, 10);
    document.querySelectorAll<HTMLFormElement>('.medical-subform, #visit-form').forEach((form) => {
      const dateInput = form.elements.namedItem('record_date') as HTMLInputElement || form.elements.namedItem('visit_date') as HTMLInputElement;
      if (dateInput) dateInput.value = today;
    });

    await Promise.all([loadPhoto(petId), loadTimeline(petId)]);
  }

  async function loadPets() {
    const { data } = await supabase
      .from('pets')
      .select('*')
      .eq('client_id', client.id)
      .order('created_at', { ascending: true });
    pets = data ?? [];
    renderPetsBar();
    if (pets.length) {
      await selectPet(activePetId && pets.some((p) => p.id === activePetId) ? activePetId : pets[0].id);
    } else {
      el('pet-record').hidden = true;
    }
  }

  async function init() {
    if (!clientId) {
      el('manage-loading').hidden = true;
      el('manage-notfound').hidden = false;
      return;
    }

    const { data: sessionData } = await supabase.auth.getSession();
    if (!sessionData.session) {
      window.location.href = '/login';
      return;
    }

    const { data: isAdmin } = await supabase.rpc('is_admin');
    if (!isAdmin) {
      el('manage-loading').hidden = true;
      el('manage-denied').hidden = false;
      return;
    }

    const { data: clientRow, error } = await supabase
      .from('clients')
      .select('*')
      .eq('id', clientId)
      .single();

    el('manage-loading').hidden = true;

    if (error || !clientRow) {
      el('manage-notfound').hidden = false;
      return;
    }

    client = clientRow;
    el('manage-area').hidden = false;
    el('client-name').textContent = client.full_name;
    el('client-meta').textContent = client.phone ?? '';

    await loadPets();
  }

  el('add-pet-form')?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const form = e.target as HTMLFormElement;
    const btn = form.querySelector('button') as HTMLButtonElement;
    const msg = el('add-pet-msg') as HTMLParagraphElement;
    btn.disabled = true;
    msg.hidden = true;

    const formData = new FormData(form);
    const result = await callPetFunction({
      action: 'create',
      client_id: client.id,
      fields: {
        name: String(formData.get('name') || '').trim(),
        species_breed: String(formData.get('species_breed') || '').trim(),
      },
    });

    msg.hidden = false;
    if (result.error) {
      msg.textContent = 'خطا: ' + result.error;
      msg.className = 'form-msg err';
    } else {
      msg.textContent = 'پت اضافه شد.';
      msg.className = 'form-msg ok';
      form.reset();
      el('add-pet-wrap').hidden = true;
      activePetId = result.pet.id;
      await loadPets();
    }
    btn.disabled = false;
  });

  el('delete-pet-btn')?.addEventListener('click', async () => {
    if (!activePetId) return;
    const pet = pets.find((p) => p.id === activePetId);
    if (!confirm(`پت «${pet?.name || pet?.species_breed || 'بدون نام'}» و همه‌ی سوابق آن (فایل، یادداشت، ویزیت، سوابق پزشکی) برای همیشه حذف می‌شود. مطمئن هستید؟`)) return;

    const result = await callPetFunction({ action: 'delete', pet_id: activePetId });
    if (!result.error) {
      activePetId = null;
      await loadPets();
    }
  });

  el('pet-details-form')?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!activePetId) return;
    const form = e.target as HTMLFormElement;
    const btn = form.querySelector('button') as HTMLButtonElement;
    const msg = el('pet-details-msg') as HTMLParagraphElement;
    btn.disabled = true;
    msg.hidden = true;

    const formData = new FormData(form);
    const result = await callPetFunction({
      action: 'update',
      pet_id: activePetId,
      fields: {
        name: String(formData.get('name') || '').trim(),
        species_breed: String(formData.get('species_breed') || '').trim(),
        sex: String(formData.get('sex') || ''),
        birth_date: String(formData.get('birth_date') || ''),
        color_markings: String(formData.get('color_markings') || '').trim(),
        microchip_band: String(formData.get('microchip_band') || '').trim(),
        allergies: String(formData.get('allergies') || '').trim(),
      },
    });

    msg.hidden = false;
    if (result.error) {
      msg.textContent = 'خطا: ' + result.error;
      msg.className = 'form-msg err';
    } else {
      msg.textContent = 'مشخصات ذخیره شد.';
      msg.className = 'form-msg ok';
      await loadPets();
    }
    btn.disabled = false;
  });

  el('visit-date-form')?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!activePetId) return;
    const form = e.target as HTMLFormElement;
    const btn = form.querySelector('button') as HTMLButtonElement;
    const msg = el('visit-date-msg') as HTMLParagraphElement;
    btn.disabled = true;
    msg.hidden = true;

    const formData = new FormData(form);
    const result = await callPetFunction({
      action: 'update',
      pet_id: activePetId,
      fields: { next_visit_date: String(formData.get('next_visit_date') || '') },
    });

    msg.hidden = false;
    if (result.error) {
      msg.textContent = 'خطا در ذخیره تاریخ.';
      msg.className = 'form-msg err';
    } else {
      msg.textContent = 'تاریخ ذخیره شد.';
      msg.className = 'form-msg ok';
      await loadPets();
    }
    btn.disabled = false;
  });

  el('photo-form')?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!activePetId) return;
    const form = e.target as HTMLFormElement;
    const btn = form.querySelector('button') as HTMLButtonElement;
    const msg = el('photo-msg') as HTMLParagraphElement;
    const fileInput = form.elements.namedItem('photo') as HTMLInputElement;
    const file = fileInput.files?.[0];
    if (!file) return;
    btn.disabled = true;
    msg.hidden = true;

    try {
      const path = safeStoragePath(client.id, file.name);
      const { error: uploadError } = await supabase.storage.from('client-files').upload(path, file);
      if (uploadError) throw uploadError;

      await supabase.from('client_files').update({ is_pet_photo: false }).eq('pet_id', activePetId).eq('is_pet_photo', true);
      const { error: insertError } = await supabase.from('client_files').insert({
        client_id: client.id,
        pet_id: activePetId,
        storage_path: path,
        original_filename: file.name,
        is_pet_photo: true,
      });
      if (insertError) throw insertError;

      msg.textContent = 'عکس با موفقیت آپلود شد.';
      msg.className = 'form-msg ok';
      msg.hidden = false;
      form.reset();
      await loadPhoto(activePetId);
    } catch (err) {
      msg.textContent = 'خطا در آپلود عکس: ' + (err instanceof Error ? err.message : String(err));
      msg.className = 'form-msg err';
      msg.hidden = false;
    } finally {
      btn.disabled = false;
    }
  });

  el('file-form')?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!activePetId) return;
    const form = e.target as HTMLFormElement;
    const btn = form.querySelector('button') as HTMLButtonElement;
    const msg = el('file-msg') as HTMLParagraphElement;
    const fileInput = form.elements.namedItem('file') as HTMLInputElement;
    const file = fileInput.files?.[0];
    if (!file) return;
    btn.disabled = true;
    msg.hidden = true;

    const formData = new FormData(form);
    try {
      const path = safeStoragePath(client.id, file.name);
      const { error: uploadError } = await supabase.storage.from('client-files').upload(path, file);
      if (uploadError) throw uploadError;

      const { error: insertError } = await supabase.from('client_files').insert({
        client_id: client.id,
        pet_id: activePetId,
        storage_path: path,
        original_filename: file.name,
        description: String(formData.get('description') || '').trim() || null,
        is_pet_photo: false,
      });
      if (insertError) throw insertError;

      msg.textContent = 'فایل با موفقیت آپلود شد.';
      msg.className = 'form-msg ok';
      msg.hidden = false;
      form.reset();
      await loadTimeline(activePetId);
    } catch (err) {
      msg.textContent = 'خطا در آپلود فایل: ' + (err instanceof Error ? err.message : String(err));
      msg.className = 'form-msg err';
      msg.hidden = false;
    } finally {
      btn.disabled = false;
    }
  });

  el('note-form')?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!activePetId) return;
    const form = e.target as HTMLFormElement;
    const btn = form.querySelector('button') as HTMLButtonElement;
    btn.disabled = true;

    const formData = new FormData(form);
    await supabase.from('client_notes').insert({
      client_id: client.id,
      pet_id: activePetId,
      note: String(formData.get('note') || '').trim(),
      is_visible_to_client: formData.get('visible') === 'on',
    });

    form.reset();
    (form.elements.namedItem('visible') as HTMLInputElement).checked = true;
    btn.disabled = false;
    await loadTimeline(activePetId);
  });

  el('visit-form')?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!activePetId) return;
    const form = e.target as HTMLFormElement;
    const btn = form.querySelector('button') as HTMLButtonElement;
    const msg = el('visit-msg') as HTMLParagraphElement;
    btn.disabled = true;
    msg.hidden = true;

    const formData = new FormData(form);
    const { error } = await supabase.from('visits').insert({
      pet_id: activePetId,
      visit_date: String(formData.get('visit_date') || '') || new Date().toISOString().slice(0, 10),
      subjective: String(formData.get('subjective') || '').trim() || null,
      objective: String(formData.get('objective') || '').trim() || null,
      assessment: String(formData.get('assessment') || '').trim() || null,
      plan: String(formData.get('plan') || '').trim() || null,
      is_visible_to_client: formData.get('visible') === 'on',
    });

    msg.hidden = false;
    if (error) {
      msg.textContent = 'خطا در ثبت ویزیت: ' + error.message;
      msg.className = 'form-msg err';
    } else {
      msg.textContent = 'ویزیت ثبت شد.';
      msg.className = 'form-msg ok';
      const today = new Date().toISOString().slice(0, 10);
      form.reset();
      (form.elements.namedItem('visible') as HTMLInputElement).checked = true;
      (form.elements.namedItem('visit_date') as HTMLInputElement).value = today;
      await loadTimeline(activePetId);
    }
    btn.disabled = false;
  });

  document.querySelectorAll<HTMLFormElement>('.medical-subform').forEach((formEl) => {
    formEl.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (!activePetId) return;
      const form = e.target as HTMLFormElement;
      const recordType = form.dataset.recordType || 'other';
      const btn = form.querySelector('button') as HTMLButtonElement;
      const msg = el('medical-msg') as HTMLParagraphElement;
      btn.disabled = true;
      msg.hidden = true;

      const formData = new FormData(form);
      const { error } = await supabase.from('client_medical_records').insert({
        client_id: client.id,
        pet_id: activePetId,
        record_type: recordType,
        record_date: String(formData.get('record_date') || '') || new Date().toISOString().slice(0, 10),
        title: String(formData.get('title') || '').trim() || null,
        value: String(formData.get('value') || '').trim() || null,
        note: String(formData.get('note') || '').trim() || null,
        is_visible_to_client: formData.get('visible') === 'on',
      });

      msg.hidden = false;
      if (error) {
        msg.textContent = 'خطا در ثبت رکورد: ' + error.message;
        msg.className = 'form-msg err';
      } else {
        msg.textContent = 'رکورد ثبت شد.';
        msg.className = 'form-msg ok';
        const today = new Date().toISOString().slice(0, 10);
        form.reset();
        (form.elements.namedItem('visible') as HTMLInputElement).checked = true;
        (form.elements.namedItem('record_date') as HTMLInputElement).value = today;
        await loadTimeline(activePetId);
      }
      btn.disabled = false;
    });
  });

  init();
</script>
