---
import Base from '../layouts/Base.astro';
---
<Base
  title="پرونده من"
  description="پرونده شخصی مشتری"
  noindex={true}
>
  <section class="portal">
    <div id="portal-loading" class="portal-status">در حال بارگذاری...</div>
    <div id="portal-empty" class="portal-status" hidden>
      این حساب به هیچ پرونده‌ای متصل نیست. لطفاً با ما تماس بگیرید.
    </div>

    <div id="portal-content" hidden>
      <div class="record">
        <div class="record-header">
          <div class="pet-photo-wrap">
            <img id="pet-photo" class="pet-photo" alt="عکس پت" hidden />
            <div id="pet-photo-placeholder" class="pet-photo-placeholder">بدون عکس</div>
          </div>
          <div class="record-header-info">
            <span class="record-kicker">پرونده دامپزشکی</span>
            <h1 id="portal-name"></h1>
            <dl class="fact-list">
              <div class="fact-row" id="fact-pet-name" hidden>
                <dt>پت</dt>
                <dd id="portal-pet-name"></dd>
              </div>
              <div class="fact-row" id="fact-subject" hidden>
                <dt>موضوع</dt>
                <dd id="portal-subject"></dd>
              </div>
              <div class="fact-row">
                <dt>تاریخ مراجعه بعدی</dt>
                <dd id="visit-date" class="fact-empty">ثبت نشده</dd>
              </div>
            </dl>
          </div>
          <button id="logout-btn" class="logout-btn">خروج</button>
        </div>

        <section class="record-section">
          <h2>مدارک و فایل‌های من</h2>
          <ul id="files-list" class="portal-list">
            <li class="portal-empty-item">فایلی آپلود نشده است.</li>
          </ul>
        </section>

        <section class="record-section">
          <h2>یادداشت‌های پیگیری</h2>
          <div id="notes-list" class="notes-list">
            <p class="portal-empty-item">یادداشتی برای نمایش وجود ندارد.</p>
          </div>
        </section>

        <section class="record-section">
          <h2>سوابق پزشکی و علمی</h2>
          <p id="medical-empty" class="portal-empty-item">رکوردی برای نمایش وجود ندارد.</p>
          <div class="table-wrap">
            <table id="medical-table" class="medical-table" hidden>
              <thead>
                <tr>
                  <th>تاریخ</th>
                  <th>نوع</th>
                  <th>عنوان</th>
                  <th>مقدار</th>
                  <th>یادداشت</th>
                </tr>
              </thead>
              <tbody id="medical-list"></tbody>
            </table>
          </div>
        </section>

        <section class="record-section">
          <h2>حیوانات تحت نگهداری من</h2>
          <div id="pets-list" class="notes-list">
            <p class="portal-empty-item">حیوانی ثبت نشده است.</p>
          </div>
        </section>

        <section class="record-section record-section-muted">
          <h2>اسم پت</h2>
          <form id="pet-name-form" class="inline-form">
            <label class="span-2">اسم پت اگزوتیک
              <input type="text" name="pet_name" placeholder="مثلاً باربی" />
            </label>
            <button type="submit" class="span-2">ذخیره</button>
          </form>
          <p id="pet-name-msg" class="form-msg" hidden></p>
        </section>
      </div>
    </div>
  </section>
</Base>

<style>
  .portal {
    max-width: 760px;
    margin: 0 auto;
    padding: 32px 20px 80px;
    min-height: 60vh;
  }
  .portal-status {
    text-align: center;
    color: var(--text-muted);
    padding: 60px 0;
  }

  .record {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    overflow: hidden;
  }

  .record-header {
    display: flex;
    align-items: center;
    gap: 20px;
    padding: 22px;
    border-bottom: 1px solid var(--border);
    position: relative;
  }
  .pet-photo-wrap {
    width: 132px;
    height: 132px;
    border-radius: 14px;
    overflow: hidden;
    background: var(--bg-soft);
    border: 1px solid var(--border);
    flex: none;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .pet-photo {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .pet-photo-placeholder {
    font-size: 12px;
    color: var(--text-muted);
    text-align: center;
    padding: 4px;
  }
  .record-header-info {
    flex: 1;
    min-width: 0;
  }
  .record-kicker {
    display: block;
    color: var(--brand);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.04em;
    margin-bottom: 4px;
  }
  .record-header h1 {
    font-size: 24px;
    line-height: 1.3;
    margin-bottom: 10px;
  }
  .fact-list {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .fact-row {
    display: flex;
    gap: 8px;
    font-size: 13px;
  }
  .fact-row dt {
    color: var(--text-muted);
    flex: none;
    width: 92px;
  }
  .fact-row dd {
    color: var(--text);
    font-weight: 600;
  }
  .fact-row dd.fact-empty {
    color: var(--text-muted);
    font-weight: 400;
  }
  .logout-btn {
    position: absolute;
    top: 18px;
    left: 18px;
    background: transparent;
    border: 1px solid var(--border);
    color: var(--text);
    border-radius: var(--radius-sm);
    padding: 6px 14px;
    font-size: 13px;
    font-family: var(--font);
    cursor: pointer;
  }
  .logout-btn:hover {
    border-color: var(--brand);
    color: var(--brand);
  }

  @media (max-width: 560px) {
    .record-header {
      flex-direction: column;
      align-items: flex-start;
      padding-top: 52px;
    }
    .pet-photo-wrap {
      width: 100%;
      height: 180px;
      border-radius: var(--radius-sm);
    }
  }

  .record-section {
    padding: 18px 22px;
    border-bottom: 1px solid var(--border);
  }
  .record-section:last-child {
    border-bottom: none;
  }
  .record-section-muted {
    background: var(--bg-soft);
  }
  .record-section h2 {
    font-size: 14px;
    font-weight: 700;
    color: var(--text-muted);
    letter-spacing: 0.02em;
    margin-bottom: 12px;
  }

  .portal-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .portal-list li {
    background: var(--bg-soft);
    border-radius: var(--radius-sm);
    padding: 9px 12px;
  }
  .portal-empty-item {
    color: var(--text-muted);
    font-size: 13px;
    background: transparent !important;
    padding: 0 !important;
  }
  .file-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 10px;
  }
  .file-row a {
    color: var(--brand-strong);
    font-weight: 600;
    font-size: 14px;
  }
  .file-meta, .item-meta {
    font-size: 12px;
    color: var(--text-muted);
    margin-top: 2px;
  }
  .note-item {
    background: var(--bg-soft);
    border-radius: var(--radius-sm);
    border-right: 3px solid var(--brand);
    padding: 9px 12px;
    margin-bottom: 8px;
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 10px;
  }
  .note-item:last-child { margin-bottom: 0; }
  .badge {
    display: inline-block;
    border-radius: 999px;
    padding: 2px 10px;
    font-size: 11px;
    font-weight: 700;
    background: var(--bg-soft);
    border: 1px solid var(--border);
    color: var(--brand);
    white-space: nowrap;
  }
  .table-wrap { overflow-x: auto; }
  .medical-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 13px;
  }
  .medical-table th,
  .medical-table td {
    padding: 8px 10px;
    text-align: right;
    border-bottom: 1px solid var(--border);
    vertical-align: top;
  }
  .medical-table th {
    color: var(--text-muted);
    font-weight: 600;
    font-size: 12px;
    white-space: nowrap;
  }
  .medical-table td { color: var(--text); }
  .medical-table td:first-child,
  .medical-table th:first-child { white-space: nowrap; }
  .medical-table tbody tr:last-child td { border-bottom: none; }
  .inline-form {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 10px;
    margin-top: 14px;
  }
  .inline-form label {
    display: flex;
    flex-direction: column;
    gap: 5px;
    font-size: 13px;
    color: var(--text-muted);
  }
  .inline-form .span-2 { grid-column: 1 / -1; }
  .inline-form input {
    background: var(--bg-soft);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    padding: 8px 11px;
    color: var(--text);
    font-family: var(--font);
    font-size: 14px;
  }
  .inline-form input:focus {
    outline: 2px solid var(--brand);
    outline-offset: 1px;
  }
  .inline-form button {
    background: var(--brand);
    color: #06110b;
    border: none;
    border-radius: var(--radius-sm);
    padding: 9px;
    font-family: var(--font);
    font-weight: 700;
    font-size: 14px;
    cursor: pointer;
  }
  .inline-form button:hover { background: var(--brand-strong); }
  .inline-form button:disabled { opacity: 0.6; cursor: default; }
  .form-msg {
    font-size: 13px;
    margin-top: 8px;
  }
  .form-msg.ok { color: #8fd6a8; }
  .form-msg.err { color: #e88a6a; }
</style>

<script>
  import { supabase } from '../lib/supabase.js';

  const el = (id: string) => document.getElementById(id) as HTMLElement;

  function esc(value: unknown): string {
    return String(value ?? '').replace(/[&<>"']/g, (c) => ({
      '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;',
    }[c] as string));
  }
  function formatDate(iso: string) {
    return new Date(iso).toLocaleDateString('fa-IR');
  }

  const MEDICAL_TYPE_LABELS: Record<string, string> = {
    weight: 'وزن',
    injection: 'تزریق / واکسن',
    prescription: 'نسخه',
    other: 'سایر',
  };

  let currentClient: any = null;

  async function loadMedical() {
    const { data: records } = await supabase
      .from('client_medical_records')
      .select('*')
      .eq('client_id', currentClient.id)
      .order('record_date', { ascending: false })
      .order('id', { ascending: false });

    if (!records || !records.length) return;
    el('medical-empty').hidden = true;
    (el('medical-table') as HTMLElement).hidden = false;
    const wrap = el('medical-list');
    wrap.innerHTML = records.map((r: any) => `
      <tr>
        <td>${formatDate(r.record_date)}</td>
        <td><span class="badge">${esc(MEDICAL_TYPE_LABELS[r.record_type] ?? r.record_type)}</span></td>
        <td>${esc(r.title ?? '')}</td>
        <td>${esc(r.value ?? '')}</td>
        <td>${esc(r.note ?? '')}</td>
      </tr>
    `).join('');
  }

  async function loadPets() {
    const { data: pets } = await supabase
      .from('client_pets')
      .select('*')
      .eq('client_id', currentClient.id)
      .order('created_at', { ascending: false });

    const wrap = el('pets-list');
    if (!pets || !pets.length) {
      wrap.innerHTML = '<p class="portal-empty-item">هنوز حیوانی ثبت نکرده‌اید.</p>';
      return;
    }
    wrap.innerHTML = pets.map((p: any) => `
      <div class="note-item">
        <div>
          <div><strong>${esc(p.species)}</strong>${p.name ? ' - ' + esc(p.name) : ''}</div>
          <div class="item-meta">${p.birth_date ? formatDate(p.birth_date) : ''} ${esc(p.notes ?? '')}</div>
        </div>
      </div>
    `).join('');
  }

  async function init() {
    const { data: sessionData } = await supabase.auth.getSession();
    if (!sessionData.session) {
      window.location.href = '/login';
      return;
    }
    const userId = sessionData.session.user.id;

    const { data: client, error: clientError } = await supabase
      .from('clients')
      .select('*')
      .eq('auth_user_id', userId)
      .single();

    el('portal-loading').hidden = true;

    if (clientError || !client) {
      el('portal-empty').hidden = false;
      return;
    }

    currentClient = client;
    el('portal-content').hidden = false;
    el('portal-name').textContent = client.full_name;

    if (client.pet_name) {
      el('portal-pet-name').textContent = client.pet_name;
      el('fact-pet-name').hidden = false;
    }
    if (client.subject) {
      el('portal-subject').textContent = client.subject;
      el('fact-subject').hidden = false;
    }
    if (client.next_visit_date) {
      el('visit-date').textContent = formatDate(client.next_visit_date);
      el('visit-date').classList.remove('fact-empty');
    }

    const petNameForm = el('pet-name-form') as HTMLFormElement;
    (petNameForm.elements.namedItem('pet_name') as HTMLInputElement).value = client.pet_name ?? '';

    const [{ data: files }, { data: notes }] = await Promise.all([
      supabase.from('client_files').select('*').eq('client_id', client.id).order('uploaded_at', { ascending: false }),
      supabase.from('client_notes').select('*').eq('client_id', client.id).eq('is_visible_to_client', true).order('created_at', { ascending: false }),
    ]);

    const photo = files?.find((f: any) => f.is_pet_photo);
    if (photo) {
      const { data: signedPhoto } = await supabase.storage
        .from('client-files')
        .createSignedUrl(photo.storage_path, 60 * 30);
      if (signedPhoto?.signedUrl) {
        const img = el('pet-photo') as HTMLImageElement;
        img.src = signedPhoto.signedUrl;
        img.hidden = false;
        el('pet-photo-placeholder').hidden = true;
      }
    }

    const docs = (files ?? []).filter((f: any) => !f.is_pet_photo);
    if (docs.length) {
      const list = el('files-list');
      list.innerHTML = '';
      for (const f of docs) {
        const li = document.createElement('li');
        const { data: signed } = await supabase.storage
          .from('client-files')
          .createSignedUrl(f.storage_path, 60 * 5);
        li.innerHTML = `
          <div class="file-row">
            <a href="${signed?.signedUrl ?? '#'}" target="_blank" rel="noopener">${esc(f.original_filename)}</a>
          </div>
          <div class="file-meta">${esc(f.description ?? '')} ${formatDate(f.uploaded_at)}</div>
        `;
        list.appendChild(li);
      }
    }

    if (notes && notes.length) {
      const wrap = el('notes-list');
      wrap.innerHTML = '';
      for (const n of notes) {
        const div = document.createElement('div');
        div.className = 'note-item';
        div.innerHTML = `<div><div>${esc(n.note)}</div><div class="item-meta">${formatDate(n.created_at)}</div></div>`;
        wrap.appendChild(div);
      }
    }

    await Promise.all([loadPets(), loadMedical()]);
  }

  el('pet-name-form')?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const form = e.target as HTMLFormElement;
    const btn = form.querySelector('button') as HTMLButtonElement;
    const msg = el('pet-name-msg') as HTMLParagraphElement;
    btn.disabled = true;
    msg.hidden = true;

    const formData = new FormData(form);
    const petName = String(formData.get('pet_name') || '').trim();
    const { error } = await supabase
      .from('clients')
      .update({ pet_name: petName || null })
      .eq('id', currentClient.id);

    msg.hidden = false;
    if (error) {
      msg.textContent = 'خطا در ذخیره اسم پت.';
      msg.className = 'form-msg err';
    } else {
      msg.textContent = 'ذخیره شد.';
      msg.className = 'form-msg ok';
      if (petName) {
        el('portal-pet-name').textContent = petName;
        el('fact-pet-name').hidden = false;
      } else {
        el('fact-pet-name').hidden = true;
      }
    }
    btn.disabled = false;
  });

  el('logout-btn')?.addEventListener('click', async () => {
    await supabase.auth.signOut();
    window.location.href = '/login';
  });

  init();
</script>
