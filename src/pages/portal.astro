---
import Base from '../layouts/Base.astro';
---
<Base
  title="پرونده من"
  description="پرونده شخصی مشتری"
  noindex={true}
>
  <section class="portal">
    <div id="portal-loading" class="portal-status">در حال بارگذاری...</div>
    <div id="portal-empty" class="portal-status" hidden>
      این حساب به هیچ پرونده‌ای متصل نیست. لطفاً با ما تماس بگیرید.
    </div>

    <div id="portal-content" hidden>
      <div class="portal-head">
        <div class="portal-head-info">
          <div id="pet-photo-wrap" class="pet-photo-wrap">
            <img id="pet-photo" class="pet-photo" alt="عکس پت" hidden />
            <div id="pet-photo-placeholder" class="pet-photo-placeholder">بدون عکس</div>
          </div>
          <div>
            <h1 id="portal-name"></h1>
            <p id="portal-pet-name" class="portal-subject" hidden></p>
            <p id="portal-subject" class="portal-subject"></p>
          </div>
        </div>
        <button id="logout-btn" class="logout-btn">خروج</button>
      </div>

      <div class="portal-grid">
        <div class="portal-card">
          <h2>تاریخ مراجعه</h2>
          <p id="visit-date" class="portal-empty-item">تاریخی ثبت نشده است.</p>
        </div>

        <div class="portal-card">
          <h2>مدارک و فایل‌های من</h2>
          <ul id="files-list" class="portal-list">
            <li class="portal-empty-item">فایلی آپلود نشده است.</li>
          </ul>
        </div>

        <div class="portal-card">
          <h2>یادداشت‌های پیگیری</h2>
          <div id="notes-list" class="notes-list">
            <p class="portal-empty-item">یادداشتی برای نمایش وجود ندارد.</p>
          </div>
        </div>

        <div class="portal-card portal-card-wide">
          <h2>حیوانات تحت نگهداری من</h2>
          <div id="pets-list" class="notes-list">
            <p class="portal-empty-item">هنوز حیوانی ثبت نکرده‌اید.</p>
          </div>
          <form id="pet-form" class="inline-form">
            <label>نوع حیوان
              <input type="text" name="species" placeholder="مثلاً طوطی، مار، لاک‌پشت..." required />
            </label>
            <label>نام
              <input type="text" name="name" />
            </label>
            <label>تاریخ تولد (تقریبی)
              <input type="date" name="birth_date" />
            </label>
            <label class="span-2">توضیحات
              <input type="text" name="notes" />
            </label>
            <button type="submit" class="span-2">افزودن حیوان</button>
          </form>
        </div>

        <div class="portal-card portal-card-wide">
          <h2>تکمیل اطلاعات من</h2>
          <form id="profile-form" class="inline-form profile-form">
            <label>نام و نام خانوادگی
              <input type="text" name="full_name" required />
            </label>
            <label>شماره تماس
              <input type="text" name="phone" required />
            </label>
            <label>ایمیل
              <input type="email" name="email" />
            </label>
            <label>اسم پت اگزوتیک
              <input type="text" name="pet_name" placeholder="مثلاً باربی" />
            </label>
            <button type="submit" class="span-2">ذخیره اطلاعات</button>
          </form>
          <p id="profile-msg" class="form-msg" hidden></p>
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  .portal {
    max-width: var(--max);
    margin: 0 auto;
    padding: 48px 20px 80px;
    min-height: 60vh;
  }
  .portal-status {
    text-align: center;
    color: var(--text-muted);
    padding: 60px 0;
  }
  .portal-head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 16px;
    margin-bottom: 32px;
    flex-wrap: wrap;
  }
  .portal-head-info {
    display: flex;
    align-items: center;
    gap: 16px;
  }
  .pet-photo-wrap {
    width: 72px;
    height: 72px;
    border-radius: 50%;
    overflow: hidden;
    background: var(--bg-soft);
    border: 1px solid var(--border);
    flex: none;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .pet-photo {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .pet-photo-placeholder {
    font-size: 11px;
    color: var(--text-muted);
    text-align: center;
    padding: 4px;
  }
  .portal-head h1 {
    font-size: 26px;
  }
  .portal-subject {
    color: var(--text-muted);
    margin-top: 4px;
  }
  .logout-btn {
    background: transparent;
    border: 1px solid var(--border);
    color: var(--text);
    border-radius: var(--radius-sm);
    padding: 8px 18px;
    font-family: var(--font);
    cursor: pointer;
  }
  .logout-btn:hover {
    border-color: var(--brand);
    color: var(--brand);
  }
  .portal-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
  }
  .portal-card-wide {
    grid-column: 1 / -1;
  }
  @media (max-width: 720px) {
    .portal-grid { grid-template-columns: 1fr; }
  }
  .portal-card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 24px;
  }
  .portal-card h2 {
    font-size: 17px;
    margin-bottom: 16px;
  }
  .portal-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .portal-list li {
    background: var(--bg-soft);
    border-radius: var(--radius-sm);
    padding: 12px 14px;
  }
  .portal-empty-item {
    color: var(--text-muted);
    font-size: 14px;
    background: transparent !important;
    padding: 0 !important;
  }
  .file-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 10px;
  }
  .file-row a {
    color: var(--brand-strong);
    font-weight: 600;
  }
  .file-meta, .item-meta {
    font-size: 12px;
    color: var(--text-muted);
    margin-top: 4px;
  }
  .note-item {
    background: var(--bg-soft);
    border-radius: var(--radius-sm);
    border-right: 3px solid var(--brand);
    padding: 12px 14px;
    margin-bottom: 12px;
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 10px;
  }
  .inline-form {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
    margin-top: 16px;
  }
  .inline-form label {
    display: flex;
    flex-direction: column;
    gap: 6px;
    font-size: 13px;
    color: var(--text-muted);
  }
  .inline-form .span-2 { grid-column: 1 / -1; }
  .inline-form input {
    background: var(--bg-soft);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    padding: 9px 12px;
    color: var(--text);
    font-family: var(--font);
    font-size: 14px;
  }
  .inline-form input:focus {
    outline: 2px solid var(--brand);
    outline-offset: 1px;
  }
  .inline-form button {
    background: var(--brand);
    color: #06110b;
    border: none;
    border-radius: var(--radius-sm);
    padding: 10px;
    font-family: var(--font);
    font-weight: 700;
    font-size: 14px;
    cursor: pointer;
  }
  .inline-form button:hover { background: var(--brand-strong); }
  .inline-form button:disabled { opacity: 0.6; cursor: default; }
  .form-msg {
    font-size: 13px;
    margin-top: 10px;
  }
  .form-msg.ok { color: #8fd6a8; }
  .form-msg.err { color: #e88a6a; }
</style>

<script>
  import { supabase } from '../lib/supabase.js';

  const el = (id: string) => document.getElementById(id) as HTMLElement;

  function esc(value: unknown): string {
    return String(value ?? '').replace(/[&<>"']/g, (c) => ({
      '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;',
    }[c] as string));
  }
  function formatDate(iso: string) {
    return new Date(iso).toLocaleDateString('fa-IR');
  }

  let currentClient: any = null;

  async function loadPets() {
    const { data: pets } = await supabase
      .from('client_pets')
      .select('*')
      .eq('client_id', currentClient.id)
      .order('created_at', { ascending: false });

    const wrap = el('pets-list');
    if (!pets || !pets.length) {
      wrap.innerHTML = '<p class="portal-empty-item">هنوز حیوانی ثبت نکرده‌اید.</p>';
      return;
    }
    wrap.innerHTML = pets.map((p: any) => `
      <div class="note-item">
        <div>
          <div><strong>${esc(p.species)}</strong>${p.name ? ' - ' + esc(p.name) : ''}</div>
          <div class="item-meta">${p.birth_date ? formatDate(p.birth_date) : ''} ${esc(p.notes ?? '')}</div>
        </div>
      </div>
    `).join('');
  }

  async function init() {
    const { data: sessionData } = await supabase.auth.getSession();
    if (!sessionData.session) {
      window.location.href = '/login';
      return;
    }
    const userId = sessionData.session.user.id;

    const { data: client, error: clientError } = await supabase
      .from('clients')
      .select('*')
      .eq('auth_user_id', userId)
      .single();

    el('portal-loading').hidden = true;

    if (clientError || !client) {
      el('portal-empty').hidden = false;
      return;
    }

    currentClient = client;
    el('portal-content').hidden = false;
    el('portal-name').textContent = client.full_name;
    el('portal-subject').textContent = client.subject ? `موضوع: ${client.subject}` : '';
    if (client.pet_name) {
      el('portal-pet-name').textContent = `پت: ${client.pet_name}`;
      el('portal-pet-name').hidden = false;
    }
    if (client.next_visit_date) {
      el('visit-date').textContent = formatDate(client.next_visit_date);
      el('visit-date').classList.remove('portal-empty-item');
    }

    const profileForm = el('profile-form') as HTMLFormElement;
    (profileForm.elements.namedItem('full_name') as HTMLInputElement).value = client.full_name ?? '';
    (profileForm.elements.namedItem('phone') as HTMLInputElement).value = client.phone ?? '';
    (profileForm.elements.namedItem('email') as HTMLInputElement).value = client.email ?? '';
    (profileForm.elements.namedItem('pet_name') as HTMLInputElement).value = client.pet_name ?? '';

    const [{ data: files }, { data: notes }] = await Promise.all([
      supabase.from('client_files').select('*').eq('client_id', client.id).order('uploaded_at', { ascending: false }),
      supabase.from('client_notes').select('*').eq('client_id', client.id).eq('is_visible_to_client', true).order('created_at', { ascending: false }),
    ]);

    const photo = files?.find((f: any) => f.is_pet_photo);
    if (photo) {
      const { data: signedPhoto } = await supabase.storage
        .from('client-files')
        .createSignedUrl(photo.storage_path, 60 * 30);
      if (signedPhoto?.signedUrl) {
        const img = el('pet-photo') as HTMLImageElement;
        img.src = signedPhoto.signedUrl;
        img.hidden = false;
        el('pet-photo-placeholder').hidden = true;
      }
    }

    const docs = (files ?? []).filter((f: any) => !f.is_pet_photo);
    if (docs.length) {
      const list = el('files-list');
      list.innerHTML = '';
      for (const f of docs) {
        const li = document.createElement('li');
        const { data: signed } = await supabase.storage
          .from('client-files')
          .createSignedUrl(f.storage_path, 60 * 5);
        li.innerHTML = `
          <div class="file-row">
            <a href="${signed?.signedUrl ?? '#'}" target="_blank" rel="noopener">${esc(f.original_filename)}</a>
          </div>
          <div class="file-meta">${esc(f.description ?? '')} ${formatDate(f.uploaded_at)}</div>
        `;
        list.appendChild(li);
      }
    }

    if (notes && notes.length) {
      const wrap = el('notes-list');
      wrap.innerHTML = '';
      for (const n of notes) {
        const div = document.createElement('div');
        div.className = 'note-item';
        div.innerHTML = `<div><div>${esc(n.note)}</div><div class="item-meta">${formatDate(n.created_at)}</div></div>`;
        wrap.appendChild(div);
      }
    }

    await loadPets();
  }

  el('profile-form')?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const form = e.target as HTMLFormElement;
    const btn = form.querySelector('button') as HTMLButtonElement;
    const msg = el('profile-msg') as HTMLParagraphElement;
    btn.disabled = true;
    msg.hidden = true;

    const formData = new FormData(form);
    const { error } = await supabase
      .from('clients')
      .update({
        full_name: String(formData.get('full_name') || '').trim(),
        phone: String(formData.get('phone') || '').trim(),
        email: String(formData.get('email') || '').trim() || null,
        pet_name: String(formData.get('pet_name') || '').trim() || null,
      })
      .eq('id', currentClient.id);

    msg.hidden = false;
    if (error) {
      msg.textContent = 'خطا در ذخیره اطلاعات.';
      msg.className = 'form-msg err';
    } else {
      msg.textContent = 'اطلاعات ذخیره شد.';
      msg.className = 'form-msg ok';
      el('portal-name').textContent = String(formData.get('full_name') || '');
      const petName = String(formData.get('pet_name') || '').trim();
      if (petName) {
        el('portal-pet-name').textContent = `پت: ${petName}`;
        el('portal-pet-name').hidden = false;
      } else {
        el('portal-pet-name').hidden = true;
      }
    }
    btn.disabled = false;
  });

  el('pet-form')?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const form = e.target as HTMLFormElement;
    const btn = form.querySelector('button') as HTMLButtonElement;
    btn.disabled = true;

    const formData = new FormData(form);
    await supabase.from('client_pets').insert({
      client_id: currentClient.id,
      species: String(formData.get('species') || '').trim(),
      name: String(formData.get('name') || '').trim() || null,
      birth_date: String(formData.get('birth_date') || '') || null,
      notes: String(formData.get('notes') || '').trim() || null,
    });

    form.reset();
    btn.disabled = false;
    await loadPets();
  });

  el('logout-btn')?.addEventListener('click', async () => {
    await supabase.auth.signOut();
    window.location.href = '/login';
  });

  init();
</script>
